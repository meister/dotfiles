ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20
DISABLE_UPDATE_PROMPT=true
PLATFORM=$(uname)
export ANTIDOTE_CACHE=~/.antidote-cache

autoload -U +X compinit && compinit
autoload -U +X bashcompinit && bashcompinit

# Load local configurations
[[ -f ~/.dotfiles/local/env.zsh ]] && source ~/.dotfiles/local/env.zsh
[[ -f ~/.dotfiles/local/pip-completion.zsh ]] && source ~/.dotfiles/local/pip-completion.zsh

# Load Antidote package manager
source ~/.antidote/antidote.zsh
source ~/.dotfiles/zsh/keybinds.zsh

# Initialize antidote's dynamic mode, which changes `antidote bundle`
# from static mode.
source <(antidote init)

# NVM & NPM plugins
export NVM_AUTO_USE=true
antidote bundle lukechilds/zsh-nvm
antidote bundle lukechilds/zsh-better-npm-completion

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

if [[ $PLATFORM == 'Darwin' ]]; then
  # In case if iTerm include shell integration script (disabled for now)
  # [[ "$TERM_PROGRAM" == "iTerm.app" ]] && source ~/.iterm2_shell_integration.`basename $SHELL`
  antidote bundle ohmyzsh/ohmyzsh path:plugins/xcode
elif [[ $PLATFORM == 'Linux' ]]; then
  antidote bundle ohmyzsh/ohmyzsh path:plugins/ubuntu
fi

# Bundles from the default repo (robbyrussell's oh-my-zsh).
antidote bundle ohmyzsh/ohmyzsh path:plugins/git
antidote bundle ohmyzsh/ohmyzsh path:plugins/pip
antidote bundle ohmyzsh/ohmyzsh path:plugins/command-not-found
antidote bundle ohmyzsh/ohmyzsh path:plugins/docker

# VIM Vundle cmd line script
antidote bundle ohmyzsh/ohmyzsh path:plugins/vundle

# Autosuggest from history
antidote bundle zsh-users/zsh-autosuggestions
antidote bundle zsh-users/zsh-completions

# Pure theme
export PURE_NODE_TRACK=1
antidote bundle mafredri/zsh-async
antidote bundle sindresorhus/pure

# antidote bundle tylerreckart/hyperzsh
#antidote bundle denysdovhan/spaceship-zsh-theme

# Include additional config from ~/.local.zshrc
[ -f ~/.zprofile ] && source ~/.zprofile
[ -f ~/.local.zshrc ] && source ~/.local.zshrc

# Syntax Highlighting command line (NOTE! Must be the last one)
zstyle ':bracketed-paste-magic' active-widgets '.self-*'
antidote bundle zsh-users/zsh-syntax-highlighting
